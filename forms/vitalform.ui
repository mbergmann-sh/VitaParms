<?xml version="1.0" encoding="UTF-8"?>
<!--
  VitaParms – Eingabemaske Vitalwerte
  Anpassbar mit Qt Designer.
   * Pflichtfeld: dateTimeEdit
   * Leere Werte: Spinboxen mit "specialValueText" (z. B. "—") gelten beim
     Minimalwert als "nicht gemessen". Bereiche und Schrittweiten sind frei
     einstellbar.
   * Eigene Felder: dynamische Eigenschaft "vpField" setzen.
-->
