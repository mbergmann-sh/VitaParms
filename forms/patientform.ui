         <property name="text"><string>&amp;Diagnosen (eine pro Zeile, gern mit ICD-10-Code):</string></property>
         <property name="buddy"><cstring>diagnosesEdit</cstring></property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="diagnosesEdit"/>
