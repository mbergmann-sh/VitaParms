        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="allergiesEdit">
         <property name="maximumSize"><size><width>16777215</width><height>70</height></size></property>
         <property name="vpField" stdset="0"><string notr="true">Allergien</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="notesLabel">
