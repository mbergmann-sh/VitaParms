<!--
  VitaParms – Stammblatt
  Dieses Formular kann mit Qt Designer angepasst werden.
  Regeln:
   * objectNames der Standardfelder nicht ändern (sonst werden sie ignoriert).
   * Pflichtfeld: lastNameEdit
   * Eigene Felder: dynamische Eigenschaft "vpField" (String) setzen –
     der Wert wird dann automatisch gespeichert.
-->
<ui version="4.0">
 <class>PatientForm</class>
 <widget class="QWidget" name="PatientForm">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>720</width><height>520</height></rect>
  </property>
  <property name="windowTitle">
   <string>Stammblatt</string>
  </property>
  <property name="formVersion" stdset="0">
   <number>5</number>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex"><number>0</number></property>

     <!-- ======================= Person ======================= -->
     <widget class="QWidget" name="personTab">
      <attribute name="title"><string>Person</string></attribute>
      <layout class="QHBoxLayout" name="personLayout">
       <item>
        <widget class="QGroupBox" name="personalGroup">
         <property name="title"><string>Persönliche Daten</string></property>
         <layout class="QFormLayout" name="personalForm">
          <item row="0" column="0">
           <widget class="QLabel" name="lastNameLabel">
            <property name="text"><string>&amp;Name *</string></property>
            <property name="buddy"><cstring>lastNameEdit</cstring></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="lastNameEdit"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="firstNameLabel">
            <property name="text"><string>&amp;Vorname</string></property>
            <property name="buddy"><cstring>firstNameEdit</cstring></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="firstNameEdit"/>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="birthDateLabel">
            <property name="text"><string>&amp;Geburtsdatum</string></property>
            <property name="buddy"><cstring>birthDateEdit</cstring></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDateEdit" name="birthDateEdit">
            <property name="displayFormat"><string>dd.MM.yyyy</string></property>
            <property name="calendarPopup"><bool>true</bool></property>
            <property name="specialValueText"><string>—</string></property>
            <property name="minimumDate"><date><year>1900</year><month>1</month><day>1</day></date></property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="sexLabel">
            <property name="text"><string>Ge&amp;schlecht</string></property>
            <property name="buddy"><cstring>sexCombo</cstring></property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QComboBox" name="sexCombo"/>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="streetLabel">
            <property name="text"><string>Straße, Nr.</string></property>
            <property name="buddy"><cstring>streetEdit</cstring></property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QLineEdit" name="streetEdit"/>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="cityLabel">
            <property name="text"><string>PLZ, Ort</string></property>
            <property name="buddy"><cstring>zipEdit</cstring></property>
           </widget>
          </item>
          <item row="5" column="1">
           <layout class="QHBoxLayout" name="cityLayout">
            <item>
             <widget class="QLineEdit" name="zipEdit">
              <property name="maximumSize"><size><width>80</width><height>16777215</height></size></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="cityEdit"/>
            </item>
           </layout>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="phoneLabel">
            <property name="text"><string>Telefon</string></property>
            <property name="buddy"><cstring>phoneEdit</cstring></property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QLineEdit" name="phoneEdit"/>
          </item>
          <item row="7" column="0">
           <widget class="QLabel" name="mobileLabel">
            <property name="text"><string>Mobiltelefon</string></property>
            <property name="buddy"><cstring>mobileEdit</cstring></property>
           </widget>
          </item>
          <item row="7" column="1">
           <widget class="QLineEdit" name="mobileEdit"/>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="extraGroup">
         <property name="title"><string>Weitere Angaben: Kontakte</string></property>
         <layout class="QVBoxLayout" name="contactLayout">
          <item>
           <widget class="QLineEdit" name="contactSearchEdit">
            <property name="placeholderText"><string>Kontakte durchsuchen (Name, Fachrichtung, Ort, Telefon …)</string></property>
            <property name="clearButtonEnabled"><bool>true</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QTableWidget" name="contactTable">
            <property name="minimumSize"><size><width>300</width><height>160</height></size></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="contactButtons">
            <item>
             <widget class="QPushButton" name="addContactButton">
              <property name="text"><string>&amp;Hinzufügen…</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="editContactButton">
              <property name="text"><string>Bearbe&amp;iten…</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="deleteContactButton">
              <property name="text"><string>Entfe&amp;rnen</string></property>
             </widget>
            </item>
            <item>
             <spacer name="contactSpacer">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLabel" name="contactHintLabel">
            <property name="text"><string>&lt;small&gt;Krankenkasse (mit Versichertennummer), Hausarzt, Fachärzte, Kliniken, Pflegedienst, Apotheke, Notfallkontakt – jeweils mit Anschrift, Telefon, Mobil, E-Mail und Website. Doppelklick öffnet einen Kontakt.&lt;/small&gt;</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ===================== Diagnosen ===================== -->
     <widget class="QWidget" name="diagnosesTab">
      <attribute name="title"><string>Diagnosen</string></attribute>
      <layout class="QVBoxLayout" name="diagnosesLayout">
       <item>
