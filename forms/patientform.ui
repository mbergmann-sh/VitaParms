        </widget>
       </item>
      </layout>
     </widget>

     <!-- ============ Pflegegrad und Schwerbehindertenausweis ============ -->
     <widget class="QWidget" name="careTab">
      <attribute name="title"><string>Pflege, Ausweis und Vorsorge</string></attribute>
      <layout class="QVBoxLayout" name="careLayout">
       <item>
        <widget class="QGroupBox" name="careGroup">
         <property name="title"><string>Pflegegrad</string></property>
         <layout class="QFormLayout" name="careForm">
          <item row="0" column="0">
           <widget class="QLabel" name="careLevelLabel">
            <property name="text"><string>&amp;Pflegegrad</string></property>
            <property name="buddy"><cstring>careLevelCombo</cstring></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="careLevelCombo">
            <item><property name="text"><string>kein Pflegegrad</string></property></item>
            <item><property name="text"><string>Pflegegrad 1 – geringe Beeinträchtigung</string></property></item>
            <item><property name="text"><string>Pflegegrad 2 – erhebliche Beeinträchtigung</string></property></item>
            <item><property name="text"><string>Pflegegrad 3 – schwere Beeinträchtigung</string></property></item>
            <item><property name="text"><string>Pflegegrad 4 – schwerste Beeinträchtigung</string></property></item>
            <item><property name="text"><string>Pflegegrad 5 – schwerste Beeinträchtigung mit besonderen Anforderungen</string></property></item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="careReviewLabel">
            <property name="text"><string>&amp;Nächste Überprüfung</string></property>
            <property name="buddy"><cstring>careReviewEdit</cstring></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDateEdit" name="careReviewEdit">
            <property name="displayFormat"><string>dd.MM.yyyy</string></property>
            <property name="calendarPopup"><bool>true</bool></property>
            <property name="specialValueText"><string>—</string></property>
            <property name="minimumDate"><date><year>2000</year><month>1</month><day>1</day></date></property>
           </widget>
          </item>
          <item row="2" column="0" colspan="2">
           <widget class="QLabel" name="careHintLabel">
            <property name="text"><string>&lt;small&gt;Termin der nächsten Begutachtung durch den Medizinischen Dienst (falls im Bescheid genannt).&lt;/small&gt;</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="disabilityGroup">
         <property name="title"><string>Schwerbehindertenausweis</string></property>
         <layout class="QFormLayout" name="disabilityForm">
          <item row="0" column="0">
           <widget class="QLabel" name="disabilityDegreeLabel">
            <property name="text"><string>&amp;Grad der Behinderung</string></property>
            <property name="buddy"><cstring>disabilityDegreeSpin</cstring></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="disabilityDegreeSpin">
            <property name="specialValueText"><string>kein Ausweis</string></property>
            <property name="prefix"><string>GdB </string></property>
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>100</number></property>
            <property name="singleStep"><number>10</number></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="disabilityMarksLabel">
            <property name="text"><string>Merkzeichen</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QWidget" name="disabilityMarksBox"/>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="disabilityValidLabel">
            <property name="text"><string>Gültig &amp;bis</string></property>
            <property name="buddy"><cstring>disabilityValidEdit</cstring></property>
           </widget>
          </item>
          <item row="2" column="1">
           <layout class="QHBoxLayout" name="disabilityValidLayout">
            <item>
             <widget class="QDateEdit" name="disabilityValidEdit">
              <property name="displayFormat"><string>dd.MM.yyyy</string></property>
              <property name="calendarPopup"><bool>true</bool></property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="disabilityUnlimitedCheck">
              <property name="text"><string>&amp;unbefristet</string></property>
             </widget>
            </item>
            <item>
             <spacer name="disabilityValidSpacer">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="careSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ================== Medikamentenplan ================== -->
     <widget class="QWidget" name="medicationTab">
      <attribute name="title"><string>Medikamentenplan</string></attribute>
      <layout class="QVBoxLayout" name="medicationLayout">
       <item>
        <widget class="QTableWidget" name="medicationTable">
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="alternatingRowColors"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="medicationButtons">
         <item>
          <widget class="QPushButton" name="addMedicationButton">
           <property name="text"><string>&amp;Hinzufügen…</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="editMedicationButton">
           <property name="text"><string>&amp;Bearbeiten…</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="archiveMedicationButton">
           <property name="text"><string>&amp;Absetzen…</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="deleteMedicationButton">
           <property name="text"><string>&amp;Löschen</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="leafletMedicationButton">
           <property name="text"><string>&amp;Beipackzettel…</string></property>
           <property name="toolTip"><string>Beipackzettel des Medikaments im Internet abrufen und anzeigen</string></property>
          </widget>
         </item>
         <item>
          <spacer name="medicationSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
          </spacer>
         </item>
         <item>
          <widget class="QCheckBox" name="showArchivedCheck">
           <property name="text"><string>Historie an&amp;zeigen</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="searchMedicationButton">
           <property name="text"><string>&amp;Suchen…</string></property>
           <property name="toolTip"><string>BtM, Schmerzmittel oder Blutverdünner im Medikamentenplan suchen – mit Dosierung und Einnahmemenge</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="printMedicationButton">
           <property name="text"><string>&amp;Drucken…</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ================= Körper & Aufnahme ================= -->
     <widget class="QWidget" name="bodyTab">
      <attribute name="title"><string>Körper &amp;&amp; Aufnahme</string></attribute>
      <layout class="QVBoxLayout" name="bodyLayout">
       <item>
        <widget class="QGroupBox" name="bioSexGroup">
         <property name="title"><string>Biologisches Geschlecht</string></property>
         <layout class="QFormLayout" name="bioSexForm">
          <item row="0" column="0">
           <widget class="QLabel" name="bioSexLabel">
            <property name="text"><string>Für &amp;Normwerte</string></property>
            <property name="buddy"><cstring>bioSexCombo</cstring></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="bioSexCombo">
            <property name="toolTip"><string>Normwerttabellen (z. B. Peak-Flow-Sollwerte) richten sich nach dem biologischen Geschlecht. Es folgt dem Feld „Geschlecht“ – ändern Sie es nur, wenn das nicht passt oder dort „divers“ steht.</string></property>
           </widget>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="QLabel" name="bioSexInfoLabel">
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="amputationGroup">
         <property name="title"><string>Gliedmaßen (für die BMI-Korrektur)</string></property>
         <layout class="QGridLayout" name="amputationGrid">
          <item row="0" column="1">
           <widget class="QLabel" name="leftHeader">
            <property name="text"><string>&lt;b&gt;links&lt;/b&gt;</string></property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel" name="rightHeader">
            <property name="text"><string>&lt;b&gt;rechts&lt;/b&gt;</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="armLabel">
            <property name="text"><string>Arm:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="armLeftCombo"/>
          </item>
          <item row="1" column="2">
           <widget class="QComboBox" name="armRightCombo"/>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="legLabel">
            <property name="text"><string>Bein:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="legLeftCombo"/>
          </item>
          <item row="2" column="2">
           <widget class="QComboBox" name="legRightCombo"/>
          </item>
          <item row="3" column="0" colspan="3">
           <widget class="QLabel" name="amputationInfoLabel">
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="peakFlowGroup">
         <property name="title"><string>Peak Flow (Asthma, COPD)</string></property>
         <layout class="QFormLayout" name="peakFlowForm">
          <item row="0" column="0">
           <widget class="QLabel" name="peakFlowBestLabel">
            <property name="text"><string>Persönlicher &amp;Bestwert</string></property>
            <property name="buddy"><cstring>peakFlowBestSpin</cstring></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="peakFlowBestSpin">
            <property name="toolTip"><string>Höchster Peak-Flow-Wert in einer beschwerdefreien Zeit, mit dem Arzt festgelegt. Ist er eingetragen, beziehen sich die Warnhinweise auf ihn statt auf den Sollwert.</string></property>
            <property name="specialValueText"><string>—</string></property>
            <property name="suffix"><string> l/min</string></property>
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>900</number></property>
            <property name="singleStep"><number>10</number></property>
           </widget>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="QLabel" name="peakFlowInfoLabel">
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="targetsRow">
         <item>
          <widget class="QGroupBox" name="inrGroup">
           <property name="title"><string>Gerinnung (INR)</string></property>
           <layout class="QFormLayout" name="inrForm">
            <item row="0" column="0">
             <widget class="QLabel" name="inrRangeLabel">
              <property name="text"><string>&amp;Zielbereich</string></property>
              <property name="buddy"><cstring>inrLowSpin</cstring></property>
             </widget>
            </item>
            <item row="0" column="1">
             <layout class="QHBoxLayout" name="inrRangeRow">
              <item>
               <widget class="QDoubleSpinBox" name="inrLowSpin">
                <property name="toolTip"><string>Ärztlich festgelegter INR-Zielbereich (z. B. 2,0–3,0, bei künstlichen Herzklappen oft 2,5–3,5). Leer: Standard 2,0–3,0.</string></property>
                <property name="specialValueText"><string>—</string></property>
                <property name="decimals"><number>1</number></property>
                <property name="maximum"><double>6.000000000000000</double></property>
                <property name="singleStep"><double>0.100000000000000</double></property>
               </widget>
              </item>
              <item>
               <widget class="QLabel" name="inrDashLabel">
                <property name="text"><string notr="true">–</string></property>
               </widget>
              </item>
              <item>
               <widget class="QDoubleSpinBox" name="inrHighSpin">
                <property name="specialValueText"><string>—</string></property>
                <property name="decimals"><number>1</number></property>
                <property name="maximum"><double>8.000000000000000</double></property>
                <property name="singleStep"><double>0.100000000000000</double></property>
               </widget>
              </item>
             </layout>
            </item>
            <item row="1" column="0" colspan="2">
             <widget class="QLabel" name="inrInfoLabel">
              <property name="wordWrap"><bool>true</bool></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="fluidGroup">
           <property name="title"><string>Trinkmenge und Gewicht</string></property>
           <layout class="QFormLayout" name="fluidForm">
            <item row="0" column="0">
             <widget class="QLabel" name="fluidMinLabel">
              <property name="text"><string>Trinkmenge &amp;mindestens</string></property>
              <property name="buddy"><cstring>fluidMinSpin</cstring></property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="fluidMinSpin">
              <property name="toolTip"><string>Hinweis, wenn an einem Tag weniger getrunken wurde (Einfuhr)</string></property>
              <property name="specialValueText"><string>—</string></property>
              <property name="suffix"><string> ml/Tag</string></property>
              <property name="maximum"><number>5000</number></property>
              <property name="singleStep"><number>100</number></property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="fluidMaxLabel">
              <property name="text"><string>Trinkmenge &amp;höchstens</string></property>
              <property name="buddy"><cstring>fluidMaxSpin</cstring></property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QSpinBox" name="fluidMaxSpin">
              <property name="toolTip"><string>Ärztlich verordnete Trinkmengenbegrenzung (z. B. bei Herzschwäche oder Dialyse)</string></property>
              <property name="specialValueText"><string>—</string></property>
              <property name="suffix"><string> ml/Tag</string></property>
              <property name="maximum"><number>5000</number></property>
              <property name="singleStep"><number>100</number></property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="weightWatchLabel">
              <property name="text"><string>Ge&amp;wichtszunahme melden ab</string></property>
              <property name="buddy"><cstring>weightWatchSpin</cstring></property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QDoubleSpinBox" name="weightWatchSpin">
