      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="stopReasonEdit">
        <property name="enabled"><bool>false</bool></property>
        <property name="placeholderText"><string>Grund des Absetzens, z. B. Nebenwirkung, Therapie beendet, ersetzt durch …</string></property>
