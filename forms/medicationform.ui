 <resources/>
 <connections>
  <connection>
   <sender>archivedCheck</sender>
   <signal>toggled(bool)</signal>
   <receiver>stopReasonEdit</receiver>
   <slot>setEnabled(bool)</slot>
  </connection>
  <connection>
   <sender>endDateCheck</sender>
   <signal>toggled(bool)</signal>
   <receiver>endDateEdit</receiver>
   <slot>setEnabled(bool)</slot>
  </connection>
 </connections>
</ui>
