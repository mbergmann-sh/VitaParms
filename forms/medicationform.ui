   <item>
    <widget class="QGroupBox" name="classGroup">
     <property name="title"><string>Kennzeichnung</string></property>
     <layout class="QVBoxLayout" name="classLayout">
      <item>
       <layout class="QHBoxLayout" name="classRow">
        <item>
