       <widget class="QCheckBox" name="archivedCheck">
        <property name="text"><string>&amp;Abgesetzt</string></property>
        <property name="toolTip"><string>Wird nicht mehr eingenommen – das Medikament wandert ins Archiv, die Historie bleibt erhalten</string></property>
